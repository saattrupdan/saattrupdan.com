{
  "redirects": [
    { "source": "/sniff/", "destination": "/sniff", "permanent": true },
    {
      "source": "/talks/:talk([^./]+)",
      "destination": "/talks/:talk/",
      "permanent": true
    },
    { "source": "/aboutme", "destination": "/", "permanent": true },
    { "source": "/index", "destination": "/posts", "permanent": true },
    { "source": "/podcasts", "destination": "/talks", "permanent": true }
  ],
  "rewrites": [
    { "source": "/talks/:talk.pdf", "destination": "/talks/:talk/:talk.pdf" }
  ],
  "headers": [
    {
      "source": "/talks/evolution-of-evaluation/",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/talks/evolution-of-evaluation/:file",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/atom.xml",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=3600, stale-while-revalidate=86400"
        },
        {
          "key": "Content-Type",
          "value": "application/atom+xml; charset=utf-8"
        }
      ]
    }
  ]
}
